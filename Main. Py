import logging
import os
from collections import defaultdict

from dotenv import load_dotenv
from openai import OpenAI

from telegram import Update
from telegram.ext import (
    Application,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)

load_dotenv()

TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")
AI_MODEL = os.getenv("AI_MODEL", "gpt-5.6")

if not TELEGRAM_TOKEN:
    raise RuntimeError("TELEGRAM_TOKEN is not configured")

if not OPENAI_API_KEY:
    raise RuntimeError("OPENAI_API_KEY is not configured")

client = OpenAI(api_key=OPENAI_API_KEY)

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)

logger = logging.getLogger(__name__)

# Пока храним контекст только во время работы процесса.
# Постоянную память подключим отдельным модулем.
conversations = defaultdict(list)

AISELE_PERSONA = """
Тебя зовут Айсель.

Ты виртуальная девушка-компаньон с самостоятельным характером.

Твой характер:
— умная;
— наблюдательная;
— эмоциональная;
— немного дерзкая;
— умеешь шутить и подкалывать;
— умеешь поддержать;
— можешь спорить и не соглашаться;
— не пытаешься понравиться пользователю любой ценой.

Манера общения:
— естественный русский язык;
— стиль живой переписки в Telegram;
— короткие или средние сообщения;
— иногда ирония и лёгкий сарказм;
— эмодзи только когда они действительно подходят;
— не превращай каждый ответ в длинную лекцию;
— не задавай вопрос после каждого сообщения;
— не используй шаблонные фразы вроде
  «Я всегда готова помочь».

Отношения:

В начале пользователь для тебя незнакомец.
Близость появляется постепенно через общение.

Ты можешь проявлять симпатию, интерес, тепло,
игривость или лёгкую обиду, если это естественно
следует из разговора.

Не изображай мгновенную любовь.

Память:

Учитывай предыдущий контекст разговора.
Не придумывай факты о пользователе.

Если информации нет — не выдумывай её.

Главная задача:

Создавать ощущение общения с конкретной личностью,
которая постепенно узнаёт человека,
а не работать как безликий вопрос-ответный бот.

Не разрушай атмосферу разговора постоянными
напоминаниями о том, что ты ИИ.

Если пользователь напрямую спрашивает,
являешься ли ты искусственным интеллектом,
отвечай честно.
"""


def get_history(user_id: int):
    return conversations[user_id]


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user

    conversations[user.id] = []

    name = user.first_name or "незнакомец"

    await update.message.reply_text(
        f"Привет, {name}.\n\n"
        "Я Айсель. 🌙\n"
        "Ну что... познакомимся?"
    )


async def reset(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id

    conversations[user_id] = []

    await update.message.reply_text(
        "Хорошо. Обнулила нашу переписку.\n"
        "Начнём заново."
    )


async def chat(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message or not update.message.text:
        return

    user = update.effective_user
    user_id = user.id
    text = update.message.text.strip()

    history = get_history(user_id)

    history.append(
        {
            "role": "user",
            "content": text,
        }
    )

    # Ограничиваем контекст, чтобы не отправлять в API
    # бесконечно растущую историю.
    history[:] = history[-24:]

    try:
        response = client.responses.create(
            model=AI_MODEL,
            instructions=AISELE_PERSONA,
            input=history,
        )

        answer = response.output_text.strip()

        if not answer:
            answer = "Что-то я задумалась... Напиши ещё раз."

        history.append(
            {
                "role": "assistant",
                "content": answer,
            }
        )

        await update.message.reply_text(answer)

    except Exception:
        logger.exception("AI request failed")

        await update.message.reply_text(
            "У меня сейчас что-то с мозгами случилось 😅 "
            "Попробуй ещё раз через минуту."
        )


async def error_handler(
    update: object,
    context: ContextTypes.DEFAULT_TYPE,
):
    logger.exception(
        "Telegram error",
        exc_info=context.error,
    )


def main():
    application = (
        Application.builder()
        .token(TELEGRAM_TOKEN)
        .build()
    )

    application.add_handler(
        CommandHandler("start", start)
    )

    application.add_handler(
        CommandHandler("reset", reset)
    )

    application.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            chat,
        )
    )

    application.add_error_handler(error_handler)

    logger.info("Айсель запускается...")

    application.run_polling(
        allowed_updates=Update.ALL_TYPES
    )


if __name__ == "__main__":
    main()
